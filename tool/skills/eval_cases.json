{
  "schemaVersion": 1,
  "tiers": {
    "smoke": {
      "defaultReplicas": 1,
      "timeoutSeconds": 120
    },
    "standard": {
      "defaultReplicas": 1,
      "timeoutSeconds": 300
    },
    "high_risk": {
      "defaultReplicas": 3,
