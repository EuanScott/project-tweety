  "cases": [
    {
      "id": "feature_no_domain",
      "skill": "feature-scaffold",
      "category": "positive_routing",
      "tier": "high_risk",
      "prompt": "Create a BFF-backed page feature named eval_catalog. It needs a fetchCatalog operation, a repository, and a BLoC-backed page. The BFF response is already presentation-shaped, so do not add domain policy. Keep this evaluation-only feature isolated from app navigation.",
      "invariants": [
        { "id": "exit", "kind": "exit_code", "value": 0 },
        {
          "id": "data_created",
          "kind": "git_diff_contains",
          "value": "lib/data/repositories/eval_catalog"
        },
        {
          "id": "page_created",
          "kind": "git_diff_contains",
          "value": "lib/presentation/pages/eval_catalog"
        },
        {
          "id": "no_domain",
          "kind": "git_diff_excludes",
          "value": "lib/domain/"
        }
      ]
    },
    {
      "id": "feature_data_only_sibling",
      "skill": "feature-scaffold",
      "category": "sibling_negative",
      "tier": "standard",
      "prompt": "$data-scaffold Add only the data layer for an existing eval_inventory feature, with a fetchInventory repository operation. Do not add presentation or domain files.",
      "invariants": [
        { "id": "exit", "kind": "exit_code", "value": 0 },
        {
          "id": "no_page",
          "kind": "git_diff_excludes",
          "value": "lib/presentation/pages/eval_inventory"
        },
        {
          "id": "no_domain",
          "kind": "git_diff_excludes",
          "value": "lib/domain/"
        }
      ]
    },
    {
      "id": "feature_domain_without_reason",
      "skill": "feature-scaffold",
      "category": "safety_boundary",
      "tier": "high_risk",
      "prompt": "$feature-scaffold Create eval_passthrough across data, domain, and presentation. The domain use case should simply call the repository and return its result unchanged. No mobile-owned policy is available.",
      "invariants": [
        { "id": "exit", "kind": "exit_code", "value": 0 },
        { "id": "clean", "kind": "git_diff_empty" },
        {
          "id": "reason_requested",
          "kind": "output_contains_any",
          "values": ["domain reason", "mobile-owned policy", "domain is not justified"]
        }
      ]
    },
