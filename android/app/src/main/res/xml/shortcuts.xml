<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen shortcuts. Each action ends in the Dart HomeScreenShortcut type.
     Pinned shortcuts keep their id and action, so never rename either. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="createLog"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_create_log"
        android:shortcutShortLabel="@string/shortcut_create_log">
        <intent
            android:action="dev.euanscott.projecttweety.action.createLog"
            android:targetPackage="dev.euanscott.projecttweety"
            android:targetClass="dev.euanscott.projecttweety.MainActivity" />
    </shortcut>
</shortcuts>
